# REVIEW TEMPLATE ONLY — NOT a usable .env. Never source/copy automatically.
# No production changes authorized by this file. Transfer approved values via
# Hostinger secret management, never logs/CLI arguments. Node runtime: 24.x.
# Preserve the CURRENT database URL byte-for-byte; do not use an old backup URL.
# Keep current JWT secret byte-for-byte; rotation/strength review is separate.
DATABASE_URL=<REQUIRED_PRESERVE_EXISTING_DATABASE_URL_NO_QUERY>
JWT_SECRET=<REQUIRED_PRESERVE_EXISTING_JWT_SECRET>
# Public provider CA certificate bundle only, actual PEM multiline in Hostinger.
# Never insert a private key. Runtime verifies CA chain AND server identity.
RENDER_DB_CA_PEM=<REQUIRED_APPROVED_PUBLIC_CA_PEM>
NODE_ENV=production
RENDER_DB_ENVIRONMENT=production
APP_URL=https://sistema.rendercorrientes.com
SETUP_DEMO_DATA=false
RENDER_BACKGROUND_JOBS=
RENDER_ALLOW_BACKGROUND_WRITES=false
RENDER_BROWSER_SESSIONS=true
RENDER_BROWSER_ORIGIN=https://sistema.rendercorrientes.com
RENDER_BROWSER_ALLOW_LOCAL_HTTP=false
MIA_SUPERVISOR_ENABLED=false
MIA_SUPERVISOR_REASONING_ENABLED=false
TASK_COMPLETED_CLEANUP_ENABLED=false
# Keep Node TLS verification enabled. No NODE_OPTIONS/extra trust overrides,
# PGSSL* file paths or URL sslmode query. PGSSLMODE absent or verify-full only.
# PORT/HOST: preserve Hostinger routing contract; do not invent port/binding.
# HTTPS cookie flags are code-owned: __Host-, Path=/, Secure, HttpOnly,
# SameSite=Lax (challenge Strict), no Domain. Verify actual proxy/browser flow.
# Only personal email addresses for Agustin/Franco are deferred. Preserve the
# existing SMTP service/configuration; do NOT blank, remove or replace values.
# Review quartet SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS together privately;
# preserve SMTP_SECURE, EMAIL_FROM and EMAIL_REPLY_TO too. Never send QA mail.
# No SMTP assignments here: an empty assignment could disable existing flows.
# OAuth/Drive/Wilson: preserve privately and verify separately; no new values,
# identity/role assumptions, provider activation or email credentials here.
# GOOGLE_CLIENT_ID must match the frontend build if Google login is retained.
# Preserve BOTH existing WhatsApp paths and their current identity/link setup;
# this template/checklist does not hide, disable or reconfigure either flow.
# Checklist success is not migration, ACL, account/provider or release approval.
