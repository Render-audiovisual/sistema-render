<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Los chunks faltantes deben devolver 404, nunca el HTML de la SPA.
  # END evita otra pasada del fallback en contexto .htaccess (Apache 2.4).
  RewriteRule ^assets(?:/|$) - [END]

  # No reescribir si es un archivo o carpeta real
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Redirigir todo a index.html para SPA
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Optimizar caché para assets con hash
<FilesMatch "\.js$|\.css$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# index.html no cachear
<Files "index.html">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</Files>
