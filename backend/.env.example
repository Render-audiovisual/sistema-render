# Definir explícitamente el destino aprobado; vacío impide arrancar.
DATABASE_URL=
# La URL debe ser PostgreSQL TCP explícita, sin parámetros de consulta/fragmento.
# Remoto: TLS >=1.2, cadena y nombre/IP verificados con autoridades de Node.
# Para una CA privada, definir RENDER_DB_CA_PEM con el PEM público completo
# (multilínea real entre comillas en dotenv); nunca pegar claves privadas.
# No usar sslmode/sslrootcert en la URL ni NODE_TLS_REJECT_UNAUTHORIZED=0.
# PGSSLMODE y certificados/rutas PGSSL* heredados no seleccionan otra política.
# Loopback exacto usa transporte local sin TLS; no combinarlo con CA/PGSSLMODE.
# Clasificación obligatoria: development, sandbox, test o production.
RENDER_DB_ENVIRONMENT=
PORT=3001
HOST=127.0.0.1
# Arranque normal sin seeds ni jobs. SETUP_DEMO_DATA=true se rechaza.
SETUP_DEMO_DATA=false
RENDER_BACKGROUND_JOBS=
RENDER_ALLOW_BACKGROUND_WRITES=false
# Jobs permitidos solo con autorización local: editorial,trash,wilson,supervisor.
# Producción permanece bloqueada para jobs en este bloque local.

# Secreto para firmar los JWT de sesión. Generá uno propio y fuerte, por
# ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reutilices el de otro entorno ni lo dejes vacío.
JWT_SECRET=

# Login con Google (Google Identity Services). El Client ID no es secreto
# (viaja al frontend igual), pero tiene que coincidir con el "Origen
# autorizado" configurado en Google Cloud Console. Ver docs/DEPLOY.md.
GOOGLE_CLIENT_ID=

# Integración interna con Google Drive. Usá el secreto del mismo cliente
# OAuth web y registrá exactamente la URL de retorno en Google Cloud.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://sistema.rendercorrientes.com/api/drive/oauth/callback

# Envío de avisos al crear o reasignar tareas. Si estas variables no están
# completas, la tarea se guarda normalmente y el email se omite.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
APP_URL=https://sistema.rendercorrientes.com
WILSON_ALLOWED_TELEGRAM_IDS=
WILSON_PUBLIC_KEY=
WILSON_SYSTEM_ACTOR_ID=mia-system

# Supervisor operativo: deshabilitado; no implica autorización de despliegue.
# Horario Argentina: lunes-sábado 08-13 y 17-21:30; tres avisos privados
# entregados, separados por tres horas laborales, antes de escalar.
MIA_SUPERVISOR_ENABLED=false
MIA_SUPERVISOR_REASONING_ENABLED=false
MIA_SUPERVISOR_REASONING_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
# El supervisor NO elimina tareas. La limpieza histórica se activa aparte.
TASK_COMPLETED_CLEANUP_ENABLED=false

# Los seeds históricos no forman parte del arranque ni del rollout Render2.
# No crear cuentas compartidas ni ejecutar bootstrap de usuarios implícito.

# El frontend canónico Render2 requiere sesiones browser y API same-origin.
# El servidor no infiere el origen ni activa cookies con un destino desconocido.
# Configurar explícitamente true SOLO en el entorno local/release autorizado;
# no desplegar este frontend contra un backend bearer antiguo. Sin configuración
# el acceso browser falla cerrado, sin recuperar credenciales de localStorage.
# RENDER_BROWSER_SESSIONS=true
# RENDER_BROWSER_ORIGIN=https://render.example.test
# HTTP sólo para NODE_ENV=development/test y origen loopback numérico explícito:
# RENDER_BROWSER_ALLOW_LOCAL_HTTP=false
